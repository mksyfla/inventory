# Template for environment/secret configuration. Copy to `.env` and replace
# every value below with real secrets. NEVER commit a `.env` file.
#
#   cp .env.example .env
#
# The Go backend (backend/) loads `.env` from the working directory, walking up
# to the repo root. docker-compose.yml also uses these variables for
# interpolation and injects them via env_file.

APP_ENV=development
# production | staging | development — staging and production disable public
# self-registration and enforce the strict secret checks below.

PORT=8080

# Database. For local runs use host localhost; docker-compose overrides this
# with the service name `db` (credentials must match POSTGRES_USER / PASSWORD /
# POSTGRES_DB below).
DB_CONN_STRING=postgres://user:password@localhost:5432/dbname?sslmode=disable

DB_POOL_MAX=10
DB_POOL_MIN=2

# Redis. Leave user/password empty for an unauthenticated local instance.
# docker-compose overrides REDIS_ADDR with `redis`.
REDIS_ADDR=localhost:6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=0

# JWT signing secret — REQUIRED, no default. Must carry at least 32 bytes of
# entropy. Generate a fresh one:
#   openssl rand -base64 48
JWT_SECRET=change-me-generate-a-strong-random-value-0123456789

# AES-256 key for partner PII encryption — REQUIRED, no default. Must decode to
# exactly 32 bytes. Either a raw 32-byte string or a base64-encoded 32-byte key:
#   openssl rand -base64 32        # e.g. Vq6p6AuwVIKsYeheeN5HDtS1/sidwXG29lZ7CSbFYP0=
AES_ENCRYPTION_KEY=this-is-a-very-secret-32byte-key
